<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AquariumWoTApp" parent="android:Theme.Material.Light.NoActionBar" />


    <!-- Tema Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Usa il colore di sfondo della tua icona -->
        <item name="windowSplashScreenBackground">#4886BF</item>
        <!-- Punta all'icona appena generata -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <!-- Imposta il tema che l'app adotterà post-splash -->
        <item name="postSplashScreenTheme">@style/Theme.AquariumWoTApp</item>
    </style>
</resources>
